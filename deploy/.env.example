# ─────────────────────────────────────────────────────────────
# Grafana Gateway — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Gateway Server ──────────────────────────────────────────
GATEWAY_PORT=8080
GATEWAY_LOG_LEVEL=info           # debug, info, warn, error

# ── Grafana Backend ─────────────────────────────────────────
# GRAFANA_URL is set in docker-compose.yml (http://grafana:3000)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=       # REQUIRED: set a strong password

# ── Authentication ──────────────────────────────────────────
GATEWAY_AUTH_ENABLED=true

# API Key 0 — Generate hash with: grafana-gateway --hash-key YOUR_KEY
GATEWAY_API_KEY_0_HASH=           # REQUIRED: SHA-256 hash of your API key
GATEWAY_API_KEY_0_USER=admin
GATEWAY_API_KEY_0_TEAM=platform
GATEWAY_API_KEY_0_ROLES=admin

# API Key 1 — (optional) Add more keys as needed
# GATEWAY_API_KEY_1_HASH=
# GATEWAY_API_KEY_1_USER=
# GATEWAY_API_KEY_1_TEAM=
# GATEWAY_API_KEY_1_ROLES=

# ── Rate Limiting ───────────────────────────────────────────
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_RPS=50        # Requests per second per key
GATEWAY_RATE_LIMIT_BURST=100     # Burst size

# ── Audit Logging ──────────────────────────────────────────
GATEWAY_AUDIT_ENABLED=true
GATEWAY_AUDIT_OUTPUT=stdout       # stdout, stderr, or file path

# ── Metrics ─────────────────────────────────────────────────
GATEWAY_METRICS_ENABLED=true

# ── Prometheus (optional, use --profile monitoring) ─────────
PROMETHEUS_PORT=9090
